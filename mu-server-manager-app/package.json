{
  "name": "server-manager",
  "private": true,
  "version": "1.0.0",
  "description": "MU Server Manager - Gerenciador de servidores MU Online",
  "author": {
    "name": "Dev-Frostty",
    "email": "dev.frostty@example.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "wait-on http://localhost:5173 && electron electron/main.cjs",
    "app": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder --win --x64",
    "build:electron:dir": "npm run build && electron-builder --win --x64 --dir",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "hello-addon": "file:native/hello-addon",
    "mssql": "^12.2.0",
    "mysql2": "^3.16.0",
    "pidusage": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "win-window": "file:native/win-window"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "node-addon-api": "^8.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}
