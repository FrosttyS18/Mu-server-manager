      {/* Footer - Dev Credits - Canto inferior direito */}
      <div className="fixed bottom-2 right-2 text-[10px] text-white/20 font-light z-[100] select-none pointer-events-none">
        Dev-Frostty © todos os direitos reservados 2026
      </div>
    </div>
  );
}

